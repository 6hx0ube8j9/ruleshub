var IS_IPV4_REGEXP = /^\d+\.\d+\.\d+\.\d+$/;

// 私有/局域网 IPv4 正则
var PRIVATE_IP_REGEXP = new RegExp([
    "^(",
    "127|",                                  // 本地环回 (127.0.0.1)
    "10|",                                   // A 类私有网段 (10.0.0.0/8)
    "192\\.168|",                            // C 类私有网段 (192.168.0.0/16)
    "100\\.(6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])|", // CGNAT 运营商大局域网 (100.64.0.0/10)
    "169\\.254|",                            // Link-Local 本地链路 (169.254.0.0/16)
    "172\\.(1[6-9]|2[0-9]|3[01])",          // B 类私有网段 (172.16.0.0/12)
    ")\\."
].join(""));

function FindProxyForURL(url, host) {
    // 1. 无点的主机名直接直连（如 http://router / http://localhost）
    if (isPlainHostName(host)) {
        return "DIRECT";
    }

    // 2. IPv4 判断与私有网段匹配
    if (IS_IPV4_REGEXP.test(host)) {
        if (PRIVATE_IP_REGEXP.test(host)) return "DIRECT";
    } 
    // 3. IPv6 判断
    else if (host.indexOf(":") !== -1) {
        if (host === "::1" || host.indexOf("fe80:") === 0 || host.indexOf("fd") === 0) {
            return "DIRECT";
        }
    }

    // 4. 域名后缀逐级查找
    var suffix = host.toLowerCase();
    while (suffix) {
        if (Object.prototype.hasOwnProperty.call(DIRECT_DOMAINS, suffix)) {
            return "DIRECT";
        }
        var pos = suffix.indexOf('.');
        if (pos === -1) break;
        suffix = suffix.substring(pos + 1);
    }

    return PROXY_METHOD;
}
